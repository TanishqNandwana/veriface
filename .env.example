# ====================================================
# VeriFace Environment Configuration Template
# ====================================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0

# Database URL
# Default fallback is SQLite (sqlite:///./veriface.db)
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/veriface
DATABASE_URL=sqlite:///./veriface.db

# CORS Allowed Origins (comma-separated, or * for all)
# Example: CORS_ORIGINS=https://veriface.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Frontend Configuration (for Vite)
# Set this to your deployed backend URL in production (e.g., https://api.yourdomain.com)
# Leave empty for local development with Vite proxy
VITE_API_BASE_URL=
